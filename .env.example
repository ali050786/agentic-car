# ============================================================================
# Environment Variables Template
# ============================================================================
#
# Copy this to .env or .env.local and fill in your actual values
#
# Location: .env.example
# ============================================================================

# Claude API Key (Claude Haiku 3.5 / Sonnet)
# Get your key: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# OpenRouter API Key (For Free Tier System & Fallbacks)
# Get your key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily API Key (web search for ResearchAgent)
# Get your key: https://tavily.com
# Needs the VITE_ prefix for client-side access (see core/agents/ResearchAgent.ts)
VITE_TAVILY_API_KEY=your_tavily_api_key_here

# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id_here
VITE_APPWRITE_DATABASE_ID=main
VITE_APPWRITE_CAROUSELS_COLLECTION_ID=carousels
VITE_APPWRITE_ANALYTICS_COLLECTION_ID=user_analytics
VITE_APPWRITE_PROFILES_COLLECTION_ID=profiles
# Server-side API Key (Scopes: databases.read, databases.write)
# Create in Appwrite Console: Settings > API Keys > Create API Key
VITE_APPWRITE_API_KEY=your_server_api_key_here

# ============================================================================
# Notes
# ============================================================================
#
# Claude Haiku/Sonnet 3.5 (Best for quality):
# - Excellent reasoning and JSON adherence
# - Very fast and affordable
# - Great for complex carousel content
#
# OpenRouter (Free tier models / fallback chain):
# - Used to resolve rate-limits or system defaults
# - Model Fallbacks: openrouter/free, meta-llama/llama-3.3-70b-instruct:free, etc.
#
# ============================================================================

# Replicate (flux image generation for Template-3 doodles)
REPLICATE_API_TOKEN=your_replicate_token_here

# Appwrite Storage bucket for generated doodles
VITE_APPWRITE_STORAGE_BUCKET_ID=your_bucket_id_here

# ============================================================================
# Background worker (worker/) — deployed separately on Coolify, see
# docs/coolify-deployment.md. Also needed locally to run `npm run worker`.
# ============================================================================

# Where the browser sends jobs. Set to http://localhost:4000 for local dev.
VITE_WORKER_URL=http://localhost:4000

# Server-side Appwrite config (NOT VITE_-prefixed — never shipped to the browser)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_DATABASE_ID=main
# Privileged key: Console > Settings > API Keys > Scopes — enable Databases, Users, and Storage.
APPWRITE_API_KEY=your_privileged_server_api_key_here

# Tavily key for the worker (ResearchAgent falls back to this when running under plain Node)
TAVILY_API_KEY=your_tavily_api_key_here

# Worker's own HTTP port and CORS allowlist
WORKER_PORT=4000
APP_ORIGIN=http://localhost:3000

# ============================================================================
# Langfuse Tracking (Performance & Agent Monitoring)
# ============================================================================
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ============================================================================
# Agent pipeline (see docs/agents-v2.md)
# ============================================================================
# v2 (default): outline → hook tournament → writer → rules → critic → proofread.
# Set to v1 to fall back to the old Plan-Execute-Reflect planner.
PIPELINE_VERSION=v2

# Models per role. Every role defaults to deepseek/deepseek-v4-flash on OpenRouter.
# Override any of them with an OpenRouter model id, e.g. LLM_MODEL_CRITIC=...
# LLM_MODEL_DEFAULT=deepseek/deepseek-v4-flash
# LLM_MODEL_FAST=
# LLM_MODEL_PLANNER=
# LLM_MODEL_WRITER=
# LLM_MODEL_CREATIVE=
# LLM_MODEL_CRITIC=
# Temperature per role (defaults: fast 0.1, planner 0.3, writer 0.75, creative 0.95, critic 0.15)
# LLM_TEMP_WRITER=0.75
# Comma-separated models tried in order when the primary fails (after 3 attempts each)
# LLM_FALLBACK_MODELS=

# Undo history collection (create it once with: npm run setup:versions)
# APPWRITE_CAROUSEL_VERSIONS_COLLECTION_ID=carousel_versions
