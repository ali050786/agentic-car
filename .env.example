# ============================================================================
# Environment Variables Template
# ============================================================================
#
# Copy this to .env or .env.local and fill in your actual values
#
# Location: .env.example
# ============================================================================

# AI Model Selection - Choose between Groq, Claude, and Gemini in the app UI

# Groq API Key (Llama 3.3 70B - Free Tier, Generous Limits)
# Get your free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Claude API Key (Claude Haiku 3.5)
# Get your free key: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Gemini API Key (Gemini Flash - Free Tier)
# Get your free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (For Free Tier System)
# Get your key: https://openrouter.ai/keys
# Used for free tier new users (first 3 generations)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily API Key (web search for ResearchAgent)
# Get your key: https://tavily.com
# Needs the VITE_ prefix for client-side access (see core/agents/ResearchAgent.ts)
VITE_TAVILY_API_KEY=your_tavily_api_key_here

# Appwrite Configuration
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id_here
VITE_APPWRITE_DATABASE_ID=main
VITE_APPWRITE_CAROUSELS_COLLECTION_ID=carousels
VITE_APPWRITE_ANALYTICS_COLLECTION_ID=user_analytics
VITE_APPWRITE_PROFILES_COLLECTION_ID=profiles
# Server-side API Key (Scopes: databases.read, databases.write)
# Create in Appwrite Console: Settings > API Keys > Create API Key
VITE_APPWRITE_API_KEY=your_server_api_key_here

# Supabase Configuration (DEPRECATED - migrated to Appwrite)
# VITE_SUPABASE_URL=your_supabase_project_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================================
# Notes
# ============================================================================
#
# Groq (Recommended for heavy usage):
# - Model: llama-3.3-70b-versatile
# - Very fast generation
# - Generous rate limits (great for free tier)
# - Good JSON adherence
#
# Claude Haiku 3.5 (Best for quality):
# - Model: claude-3-5-haiku-20241022
# - Excellent reasoning and JSON adherence
# - Very fast and affordable
# - Great for complex carousel content
#
# Gemini Flash (Google's Free Model):
# - Model: gemini-1.5-flash
# - Free tier with generous limits
# - Excellent JSON adherence
# - Fast generation with good reasoning
# - Native JSON mode support
#
# OpenRouter (Alternative - Deprecated):
# - Model: google/gemini-2.0-flash-exp:free
# - Requires HTTP-Referer and X-Title headers
#
# ============================================================================

# Replicate (flux image generation for Template-3 doodles)
REPLICATE_API_TOKEN=your_replicate_token_here

# Appwrite Storage bucket for generated doodles
VITE_APPWRITE_STORAGE_BUCKET_ID=your_bucket_id_here

# ============================================================================
# Background worker (worker/) — deployed separately on Coolify, see
# docs/coolify-deployment.md. Also needed locally to run `npm run worker`.
# ============================================================================

# Where the browser sends jobs. Set to http://localhost:4000 for local dev.
VITE_WORKER_URL=http://localhost:4000

# Server-side Appwrite config (NOT VITE_-prefixed — never shipped to the browser)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_DATABASE_ID=main
# Privileged key: Console > Settings > API Keys > the key > Scopes — enable
# every checkbox under Databases (collections, attributes, indexes,
# documents; "databases.read/write" alone only covers documents, not schema
# changes like creating the generation_jobs collection), Users, and Storage.
# Do NOT reuse VITE_APPWRITE_API_KEY above.
APPWRITE_API_KEY=your_privileged_server_api_key_here

# Tavily key for the worker (ResearchAgent falls back to this when
# import.meta.env isn't available, i.e. when running under plain Node)
TAVILY_API_KEY=your_tavily_api_key_here

# Worker's own HTTP port and CORS allowlist
WORKER_PORT=4000
APP_ORIGIN=http://localhost:3000
